# CoinQuest — copy to .env and fill in. .env is gitignored and never committed.

# The child's display name. The code never hardcodes a name; this is the only
# place one appears, so the repository stays free of family detail.
CHILD_NAME=

# Parent PIN authorising confirms, deposits and withdrawals. Verified
# server-side only and never sent to a client.
PARENT_PIN=

# How many consecutive wrong PINs one source may try before it is refused for
# a while. The cooling-off clears itself — there is no administrator here to
# unlock anything — and doubles on each consecutive lockout, up to the cap: 30
# seconds, then a minute, two, four, eight, and no longer than fifteen.
# A mistype on the kitchen screen costs half a minute; sustained guessing gets
# expensive quickly. A correct PIN puts it back to the start.
PIN_ATTEMPT_LIMIT=5
PIN_COOL_OFF_START_SECONDS=30
PIN_COOL_OFF_MAX_SECONDS=900

# SQLite database file. On the Pi this points inside the mounted data volume.
DATABASE_URL=sqlite:////data/coinquest.db

# The weekly base allowance, in pence. Paid every week whatever happens with
# the chores; only a voided week removes it. The chore pay is separate and is
# earned, so it can be lost.
WEEKLY_BASE_PENCE=100

# Port the service listens on.
COINQUEST_PORT=8600

# Every week boundary, payday and monthly match depends on this. The container
# clock is UTC; without it, "today" is wrong between midnight and 01:00 BST.
TZ=Europe/London
