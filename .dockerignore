# Keep the build context small and, more importantly, keep host state out of
# the image — a copied .env or coinquest.db would silently override the
# container's own configuration and data, and a copied node_modules would not
# even be the right architecture.
.git/
.github/

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

frontend/node_modules/
frontend/dist/

# Host data. The container's own lives on the mounted volume.
.env
*.db
*.db-journal
*.db-wal
*.db-shm

docs/
tests/
*.md
